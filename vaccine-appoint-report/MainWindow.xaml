<Window x:Class="vaccine_appoint_report.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:vaccine_appoint_report.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:vaccine_appoint_report.UserControls"
        xmlns:v="clr-namespace:vaccine_appoint_report.Validations"
        xmlns:local="clr-namespace:vaccine_appoint_report"
        xmlns:vm="clr-namespace:VaccineReportBackend.ViewModels;assembly=VaccineReportBackend"
        mc:Ignorable="d"     
        Title="MainWindow" Height="400" Width="400"
        WindowStartupLocation="CenterOwner" 
        Style="{StaticResource GlobalStyle}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <cv:WindowSizeConverter x:Key="WindowSizeConverter" />
        <BooleanToVisibilityConverter x:Key="VisibilityConverter" />
    </Window.Resources>

    <StackPanel>
        <Label
            Style="{StaticResource AppTitleText}"
            Content="แอพออกนัด" />
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label 
                Content="Vaccine"
                Style="{StaticResource BaseLabel}"
                Grid.Row="0" Grid.Column="0" />
            <Label 
                Content="Appointment Dose"
                Style="{StaticResource BaseLabel}"
                Grid.Row="0" Grid.Column="1" />
            <ComboBox 
                IsEditable="True" 
                Name="VaccineComboBox"
                Style="{StaticResource BaseComboBox}"
                ItemsSource="{Binding Vaccines, Mode=TwoWay}"
                SelectedValue="{Binding VaccineCode, Mode=OneWayToSource}"
                DisplayMemberPath="Name"
                SelectedValuePath="VaccineCode"
                Grid.Row="1" Grid.Column="0" />
            <TextBox 
                Style="{StaticResource BaseTextBox}"
                Grid.Row="1" Grid.Column="1">
                <TextBox.Text>
                    <Binding Path="Dose" ValidatesOnExceptions="True">
                        <Binding.ValidationRules>
                            <v:StringToNumeric ValidationStep="RawProposedValue" />
                            <ExceptionValidationRule />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <Label 
                Content="StartDate"
                Style="{StaticResource BaseLabel}"
                Grid.Row="2" Grid.Column="0" />
            <Label 
                Content="Appointment Date"
                Style="{StaticResource BaseLabel}"
                Grid.Row="2" Grid.Column="1" />
            <DatePicker 
                Name="StartDatePicker"
                Style="{StaticResource BaseDatePicker}"
                SelectedDateFormat="Short"
                SelectedDate="{Binding StartDate, Mode=TwoWay}" 
                Grid.Row="3" Grid.Column="0" />
            <DatePicker 
                Name="AppointDatePicker"
                Style="{StaticResource BaseDatePicker}"
                DisplayDateStart="{Binding StartDate}"
                SelectedDateFormat="Short"
                SelectedDate="{Binding EndDate, Mode=TwoWay}" 
                Grid.Row="3" Grid.Column="1" />
            <Label 
                Style="{StaticResource BaseLabel}"
                Content="Sub Vaccine Appointment Plan" 
                Grid.Row="4" Grid.Column="0" />
            <ComboBox 
                Name="SubPlanComboBox"
                ItemsSource="{Binding SubPlans, Mode=OneWay}"
                DisplayMemberPath="SubPlanName"
                SelectedValuePath="SubPlanKey"
                SelectedValue="{Binding SubVaccinePlanCode, Mode=OneWayToSource}"
                Style="{StaticResource BaseComboBox}"
                Grid.Row="5" Grid.Column="0" />
            <Label 
                Content="Specify Doctor Code"
                Style="{StaticResource BaseLabel}"
                Grid.Row="4" Grid.Column="1" />
            <ComboBox 
                Name="DoctorComboBox"
                IsEditable="True"
                ItemsSource="{Binding Doctors, Mode=TwoWay}"
                DisplayMemberPath="FullName"
                SelectedValuePath="DoctorCode"
                Style="{StaticResource BaseComboBox}"
                Grid.Row="5" Grid.Column="1" />
        </Grid>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button 
                Content="Execute" 
                Command="{Binding FetchAppointmentsCommand}" 
                Grid.Row="0" Grid.Column="0"
                Style="{StaticResource BaseButton}"/>
            <Button 
                Content="Export as Excel 2010+" 
                Command="{Binding ExportExcelCommand}"
                Grid.Row="0" Grid.Column="1" 
                Style="{StaticResource BaseButton}" />
            <uc:MessageGrid
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                DataContext="{Binding Path=DataContext.MessageGridViewModel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" 
                Visibility="{Binding IsMessageGridVisible, Converter={StaticResource VisibilityConverter}, Mode=OneWay}"  />
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="{Binding Path=IsDataGridVisible, Converter={StaticResource VisibilityConverter}, Mode=OneWay}">
                <TextBlock Text="จำนวนนัด: " />
                <TextBlock Text="{Binding AppointmentResults.Count, Mode=OneWay}" />
                <TextBlock Text=" ราย" />
            </StackPanel>
            <DataGrid
                AutoGenerateColumns="False"
                ItemsSource="{Binding AppointmentResults}"
                CanUserAddRows="False"
                CanUserReorderColumns="True"
                MaxHeight="{Binding Source={x:Static SystemParameters.PrimaryScreenHeight}, Converter={StaticResource WindowSizeConverter}, ConverterParameter='0.5'}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                Margin="0,8" 
                Grid.Row="3" 
                Grid.Column="0" 
                Grid.ColumnSpan="2"
                Visibility="{Binding IsDataGridVisible, Converter={StaticResource VisibilityConverter}, Mode=OneWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn 
                        Width="auto"
                        Header="วันนัดถัดไป"
                        Binding="{Binding NextScheduleDate, Mode=OneWay, StringFormat={}{0: dd/MM/yyyy}}"/>
                    <DataGridTextColumn 
                        Width="auto"
                        Header="วันที่รับบริการ"
                        Binding="{Binding InjectionDate, Mode=OneWay, StringFormat={}{0: dd/MM/yyyy}}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="วัคซีนที่ได้รับครั้งก่อน"
                        Binding="{Binding VaccineName, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="HN"
                        Binding="{Binding HN, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto" 
                        Header="เลขประจำตัวประชาชน"
                        Binding="{Binding CID, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="ชื่อ-สกุล"
                        Binding="{Binding Fullname, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="วันเกิด"
                        Binding="{Binding Birthdate, Mode=OneWay, StringFormat={}{0: dd/MM/yyyy}}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="อายุ"
                        Binding="{Binding Age, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto" 
                        Header="ที่อยู่"
                        Binding="{Binding Address, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="เบอร์โทรติดต่อ"
                        Binding="{Binding Telephone, Mode=OneWay}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </StackPanel>
</Window>
