<UserControl x:Class="vaccine_appoint_report.UserControls.MessageGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:vaccine_appoint_report.UserControls"
             xmlns:vm="clr-namespace:VaccineReportBackend.ViewModels;assembly=VaccineReportBackend"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Image 
            Grid.Column="0"
            Grid.Row="0"
            Source="{Binding StatusImgPath, Mode=OneWay}" />
        <TextBlock 
            Grid.Column="1"
            Grid.Row="0"
            Style="{StaticResource BaseMessageText}"
            Text="{Binding Message, Mode=OneWay}">
        </TextBlock>
    </Grid>
</UserControl>
