<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Font Resources Key -->
    <FontFamily x:Key="Kanit">pack://application:,,,/Resources/Fonts/#Kanit</FontFamily>
    
    <!-- Global Window Style -->
    <Style x:Key="GlobalStyle" TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="{StaticResource Kanit}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- MainWindowStyle -->
    <Style x:Key="AppTitleText" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style x:Key="BaseControlSpacing">
        <Setter Property="Control.Margin" Value="0,0,8,0"/>
        <Setter Property="Control.Padding" Value="6" />
    </Style>

    <Style x:Key="BaseLabel" TargetType="Label">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <Style x:Key="BaseDatePicker" TargetType="DatePicker" BasedOn="{StaticResource BaseControlSpacing}" >
    </Style>

    <Style x:Key="BaseComboBox" TargetType="ComboBox" BasedOn="{StaticResource BaseControlSpacing}">
    </Style>

    <Style x:Key="BaseTextBox" TargetType="TextBox" BasedOn="{StaticResource BaseControlSpacing}">
    </Style>

    <Style x:Key="BaseButton" TargetType="Button" BasedOn="{StaticResource BaseControlSpacing}">
        <Setter Property="Padding" Value="8" />
    </Style>
    <!-- End MainWindowStyle-->

    <!-- User Control: MessageGrid Style-->
    <Style x:Key="BaseMessageText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8" />
    </Style>

</ResourceDictionary>