<Window x:Class="VaccineAppointmentUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:VaccineAppointmentUI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:VaccineAppointmentUI.UserControls"
        xmlns:tr="clr-namespace:VaccineAppointmentUI.Resources.Translations"
        xmlns:v="clr-namespace:VaccineAppointmentUI.Validations"
        xmlns:local="clr-namespace:VaccineAppointmentUI"
        xmlns:vm="clr-namespace:VaccineReportBackend.ViewModels;assembly=VaccineReportBackend" 
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"     
        Title="{x:Static tr:Resource.AppTitle}" 
        Height="{Binding Source={x:Static SystemParameters.PrimaryScreenHeight}, Converter={StaticResource WindowSizeConverter}, ConverterParameter='0.7'}"
        Width="800"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource GlobalStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibilityConverter" />
    </Window.Resources>

    <Grid Style="{StaticResource MainGrid}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Label
            Grid.Row="0"
            Style="{StaticResource AppTitleText}"
            Content="{x:Static tr:Resource.AppTitle}" />
        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label 
                Content="{x:Static tr:Resource.VaccineLabel}"
                Style="{StaticResource BaseLabel}"
                Grid.Row="0" Grid.Column="0" />
            <Label 
                Content="{x:Static tr:Resource.DoseLabel}"
                Style="{StaticResource BaseLabel}"
                Grid.Row="0" Grid.Column="1" />
            <ComboBox 
                IsEditable="True"
                Name="VaccineComboBox"
                Style="{StaticResource BaseComboBox}"
                ItemsSource="{Binding Vaccines, Mode=TwoWay}"
                ToolTip="{x:Static tr:Resource.VaccineTooltip}"
                SelectedValue="{Binding VaccineCode, Mode=OneWayToSource}"
                DisplayMemberPath="Name"
                SelectedValuePath="VaccineCode"
                Grid.Row="1" Grid.Column="0" />
            <TextBox 
                Style="{StaticResource BaseTextBox}"
                ToolTip="{x:Static tr:Resource.DoseTooltip}"
                Grid.Row="1" Grid.Column="1">
                <TextBox.Text>
                    <Binding Path="Dose" ValidatesOnExceptions="True">
                        <Binding.ValidationRules>
                            <v:StringToNumeric ValidationStep="RawProposedValue" />
                            <ExceptionValidationRule />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <Label 
                Content="{x:Static tr:Resource.StartDateLabel}"
                Style="{StaticResource BaseLabel}"
                Grid.Row="2" Grid.Column="0" />
            <Label 
                Content="{x:Static tr:Resource.EndDateLabel}"
                Style="{StaticResource BaseLabel}"
                Grid.Row="2" Grid.Column="1" />
            <DatePicker 
                Name="StartDatePicker"
                ToolTip="{x:Static tr:Resource.StartDateTooltip}"
                Style="{StaticResource BaseDatePicker}"
                SelectedDateFormat="Short"
                SelectedDate="{Binding StartDate, Mode=TwoWay}" 
                Grid.Row="3" Grid.Column="0" />
            <DatePicker 
                Name="AppointDatePicker"
                ToolTip="{x:Static tr:Resource.EndDateTooltip}"
                Style="{StaticResource BaseDatePicker}"
                DisplayDateStart="{Binding StartDate}"
                SelectedDateFormat="Short"
                SelectedDate="{Binding EndDate, Mode=TwoWay}" 
                Grid.Row="3" Grid.Column="1" />
            <Label 
                Content="{x:Static tr:Resource.SubVacLabel}" 
                Grid.Row="4" Grid.Column="0"
                Style="{StaticResource BaseLabel}" />
            <ComboBox 
                Name="SubPlanComboBox"
                DisplayMemberPath="SubPlanName"
                Grid.Row="5" Grid.Column="0"
                ItemsSource="{Binding SubPlans, Mode=OneWay}"
                SelectedValuePath="SubPlanKey"
                SelectedValue="{Binding SubVaccinePlanCode, Mode=OneWayToSource}"
                Style="{StaticResource BaseComboBox}" 
                ToolTip="{x:Static tr:Resource.SubVacTooltip}" />
            <Label 
                Content="{x:Static tr:Resource.DocCodeLabel}"
                Grid.Row="4" Grid.Column="1"
                Style="{StaticResource BaseLabel}" />
            <ComboBox 
                DisplayMemberPath="FullName"
                Grid.Row="5" Grid.Column="1"
                ItemsSource="{Binding Doctors, Mode=TwoWay}"
                IsEditable="True"
                Name="DoctorComboBox"
                SelectedValuePath="DoctorCode"
                Style="{StaticResource BaseComboBox}" 
                ToolTip="{x:Static tr:Resource.DocCodeTooltip}"/>
        </Grid>

        <Grid 
            Grid.Row="2" 
            Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button 
                Content="{x:Static tr:Resource.FetchBtnText}" 
                Command="{Binding FetchAppointmentsCommand}"
                IsDefault="True"
                Grid.Row="0" Grid.Column="0"
                Style="{StaticResource BaseButton}"/>
            <Button 
                Content="{x:Static tr:Resource.ExportExcelBtnText}" 
                Command="{Binding ExportExcelCommand}"
                Grid.Row="0" Grid.Column="1" 
                Style="{StaticResource BaseButton}" />
            <StackPanel
                DataContext="{Binding Path=DataContext.MessageGridViewModel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Vertical"
                Margin="0,16">
                <Label
                    Style="{StaticResource AppTitleText}"
                    Content="{x:Static tr:Resource.AppState}"
                    Visibility="{Binding IsMessageGridVisible, Converter={StaticResource VisibilityConverter}, Mode=OneWay}"/>
                <uc:MessageGrid
                    Visibility="{Binding IsMessageGridVisible, Converter={StaticResource VisibilityConverter}, Mode=OneWay}"  />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="{Binding Path=IsDataGridVisible, Converter={StaticResource VisibilityConverter}, Mode=OneWay}">
                <TextBlock Text="จำนวนนัด: " />
                <TextBlock Text="{Binding AppointmentResults.Count, Mode=OneWay}" />
                <TextBlock Text=" ราย" />
            </StackPanel>
            <StackPanel
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                Visibility="{Binding IsDataGridVisible, Converter={StaticResource VisibilityConverter}, Mode=OneWay}">
                <Label 
                    Style="{StaticResource BaseLabel}"
                    Margin="0,8,8,8"
                    Content="{x:Static tr:Resource.SearchLabel}" />
                <TextBox
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="{x:Static tr:Resource.SearchTooltip}"
                    Width="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}, Converter={StaticResource WindowSizeConverter}, ConverterParameter='0.15'}"
                    MaxWidth="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}, Converter={StaticResource WindowSizeConverter}, ConverterParameter='0.2'}"
                    Padding="8"
                    VerticalAlignment="Center" />
            </StackPanel>
            <DataGrid
                AutoGenerateColumns="False"
                ItemsSource="{Binding AppointmentResults, Mode=OneWay}"
                CanUserReorderColumns="True"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                EnableRowVirtualization="True"
                Margin="0,8"
                Grid.Row="4"
                Grid.Column="0" 
                Grid.ColumnSpan="2"
                Visibility="{Binding IsDataGridVisible, Converter={StaticResource VisibilityConverter}, Mode=OneWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn 
                        Width="auto"
                        Header="{x:Static tr:Resource.AppointDateHeader}"
                        Binding="{Binding NextScheduleDate, Mode=OneWay, StringFormat={}{0: dd/MM/yyyy}}"/>
                    <DataGridTextColumn 
                        Width="auto"
                        Header="{x:Static tr:Resource.InjectionDateHeader}"
                        Binding="{Binding InjectionDate, Mode=OneWay, StringFormat={}{0: dd/MM/yyyy}}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="{x:Static tr:Resource.VacNameHeader}"
                        Binding="{Binding VaccineName, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="{x:Static tr:Resource.HnHeader}"
                        Binding="{Binding HN, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto" 
                        Header="{x:Static tr:Resource.CidHeader}"
                        Binding="{Binding CID, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="{x:Static tr:Resource.FullNameHeader}"
                        Binding="{Binding Fullname, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="{x:Static tr:Resource.BirthdateHeader}"
                        Binding="{Binding Birthdate, Mode=OneWay, StringFormat={}{0: dd/MM/yyyy}}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="{x:Static tr:Resource.AgeHeader}"
                        Binding="{Binding Age, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto" 
                        Header="{x:Static tr:Resource.AddressHeader}"
                        Binding="{Binding Address, Mode=OneWay}" />
                    <DataGridTextColumn 
                        Width="auto"
                        Header="{x:Static tr:Resource.TelHeader}"
                        Binding="{Binding Telephone, Mode=OneWay}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
